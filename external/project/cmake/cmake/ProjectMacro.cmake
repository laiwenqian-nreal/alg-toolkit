MACRO( PROJECT_INIT_TARGET_VARIABLE _name )
	set( TARGET_NAME ${_name} )
	set( TARGET_NAME_SHARED ${_name}_shared )
	set( TARGET_NAME_STATIC ${_name}_static )
	set( TARGET_NAME_OBJECT ${_name}_object )
	set( TARGET_NAME_INTERFACE ${_name}_interface )
	set( TARGET_INCLUDE_PATH "${CMAKE_CURRENT_SOURCE_DIR}" )
	set( TARGET_SOURCE_PATH "${CMAKE_CURRENT_SOURCE_DIR}" )
	file( GLOB TARGET_HEADER_FILES "${TARGET_INCLUDE_PATH}/*.h" )
	file( GLOB TARGET_SOURCE_FILES "${TARGET_SOURCE_PATH}/*.cc" "${TARGET_SOURCE_PATH}/*.cpp" "${TARGET_SOURCE_PATH}/*.c" "${TARGET_SOURCE_PATH}/*.h.in")
ENDMACRO()

MACRO( PROJECT_INIT_TARGET_VARIABLE_RECURSE _name )
	set( TARGET_NAME ${_name} )
	set( TARGET_NAME_SHARED ${_name}_shared )
	set( TARGET_NAME_STATIC ${_name}_static )
	set( TARGET_NAME_OBJECT ${_name}_object )
	set( TARGET_INCLUDE_PATH "${CMAKE_CURRENT_SOURCE_DIR}" )
	set( TARGET_SOURCE_PATH "${CMAKE_CURRENT_SOURCE_DIR}" )
	file( GLOB_RECURSE TARGET_HEADER_FILES "${TARGET_INCLUDE_PATH}/*.h" )
	file( GLOB_RECURSE TARGET_SOURCE_FILES "${TARGET_SOURCE_PATH}/*.cc" "${TARGET_SOURCE_PATH}/*.cpp" "${TARGET_SOURCE_PATH}/*.c" "${TARGET_SOURCE_PATH}/*.h.in")
ENDMACRO()

MACRO( PROJECT_CONFIGURE_FILE _file_name )
	configure_file(
		${TARGET_INCLUDE_PATH}/${_file_name}.in 
		${CMAKE_CURRENT_BINARY_DIR}/${_file_name}
		@ONLY
		)
	list( APPEND TARGET_HEADER_FILES ${CMAKE_CURRENT_BINARY_DIR}/${_file_name} )
ENDMACRO()

MACRO( PROJECT_INSTALL _target_name _target_export_name)
install(
	TARGETS ${_target_name}
	EXPORT  ${_target_export_name}
	LIBRARY  DESTINATION "${CMAKE_INSTALL_LIBDIR}"
	ARCHIVE  DESTINATION "${CMAKE_INSTALL_LIBDIR}"
	RUNTIME  DESTINATION "${CMAKE_INSTALL_BINDIR}"
	INCLUDES DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
ENDMACRO()

MACRO( ADD_PLUGIN_LIBRARIES_INTERNAL _NAME _SYMBOL_TYPE _ONLY_SHARED_LIBRARY_USED_LIBRARY _ONLY_STATIC_LIBRARY_USED_LIBRARY ) 
message(STATUS "_NAME: ${_NAME}")
message(STATUS "_SYMBOL_TYPE: ${_SYMBOL_TYPE}")
message(STATUS "_ONLY_SHARED_LIBRARY_USED_LIBRARY: ${_ONLY_SHARED_LIBRARY_USED_LIBRARY}")
message(STATUS "_ONLY_STATIC_LIBRARY_USED_LIBRARY: ${_ONLY_STATIC_LIBRARY_USED_LIBRARY}")
message(STATUS "COMMON LIBRARYS: ${ARGN}")

set( TARGET_BASE_NAME ${_NAME} )
set( TARGET_STATIC_NAME ${TARGET_BASE_NAME}_static )
set( TARGET_SHARED_ALL_SYMBOLS_NAME ${TARGET_BASE_NAME}_all_symbols )
set( ALL_LINKED_LIBRARY_LIST ${ARGN} )
set( DUMMY_FILE ${CMAKE_CURRENT_BINARY_DIR}/dummy.cc)

file(TOUCH ${DUMMY_FILE})

# shared library
add_library( ${TARGET_BASE_NAME} SHARED)
target_sources( ${TARGET_BASE_NAME} PRIVATE ${DUMMY_FILE})
target_link_libraries( ${TARGET_BASE_NAME}
    PUBLIC
    ${_ONLY_SHARED_LIBRARY_USED_LIBRARY}
    ${ALL_LINKED_LIBRARY_LIST}
    )

# static library
add_library( ${TARGET_STATIC_NAME} STATIC)
target_sources( ${TARGET_STATIC_NAME} PRIVATE ${DUMMY_FILE})
target_link_libraries( ${TARGET_STATIC_NAME}
    PUBLIC
	${_ONLY_STATIC_LIBRARY_USED_LIBRARY}
    ${ALL_LINKED_LIBRARY_LIST}
    )

# shared all symbols library
add_library( ${TARGET_SHARED_ALL_SYMBOLS_NAME} SHARED )
target_sources( ${TARGET_SHARED_ALL_SYMBOLS_NAME} PRIVATE ${DUMMY_FILE})
target_link_libraries( ${TARGET_SHARED_ALL_SYMBOLS_NAME}
    PUBLIC
    ${_ONLY_SHARED_LIBRARY_USED_LIBRARY}
    ${ALL_LINKED_LIBRARY_LIST}
    )

PROJECT_STRIP_LINK_OPTIONS(${TARGET_BASE_NAME} ${TARGET_SHARED_ALL_SYMBOLS_NAME} ${_SYMBOL_TYPE} TRUE)

PROJECT_INSTALL(${TARGET_BASE_NAME} ${TARGETS_EXPORT_NAME})
PROJECT_INSTALL(${TARGET_STATIC_NAME} ${TARGETS_EXPORT_NAME})
# PROJECT_INSTALL(${TARGET_SHARED_ALL_SYMBOLS_NAME} ${TARGETS_EXPORT_NAME})
ENDMACRO()

# usage : ADD_PLUGIN_LIBRARIES( target_name only_shared_library_used only_static_library_used [library1 library2 ... ])
# if only_shared_library_used or only_shared_library_used is not used, set it to ""
# target_name, only_shared_library_used, only_static_library_used is necessory!
MACRO( ADD_PLUGIN_LIBRARIES _NAME _ONLY_SHARED_LIBRARY_USED_LIBRARY _ONLY_STATIC_LIBRARY_USED_LIBRARY) 
	ADD_PLUGIN_LIBRARIES_INTERNAL( ${_NAME} "symbol_type_nr_plugin" "${_ONLY_SHARED_LIBRARY_USED_LIBRARY}" "${_ONLY_STATIC_LIBRARY_USED_LIBRARY}" ${ARGN})
ENDMACRO()
MACRO( ADD_PLUGIN_LIBRARIES_EXT _NAME _ONLY_SHARED_LIBRARY_USED_LIBRARY _ONLY_STATIC_LIBRARY_USED_LIBRARY) 
	ADD_PLUGIN_LIBRARIES_INTERNAL( ${_NAME} "symbol_type_nr_plugin_ext" "${_ONLY_SHARED_LIBRARY_USED_LIBRARY}" "${_ONLY_STATIC_LIBRARY_USED_LIBRARY}" ${ARGN})
ENDMACRO()
