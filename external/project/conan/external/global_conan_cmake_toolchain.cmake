# Avoid including toolchain file several times (bad if appending to variables like
#   CMAKE_CXX_FLAGS. See https://github.com/android/ndk/issues/323
include_guard()

message(STATUS "Using Global toolchain: ${CMAKE_CURRENT_LIST_FILE}")

######################################################################################
##                              COMMAND LINE                                        ##
######################################################################################
set(CMAKE_VERBOSE_MAKEFILE ON CACHE BOOL "")
######################################################################################
##                              PACKAGES                                            ##
######################################################################################
set(THREADS_PREFER_PTHREAD_FLAG ON CACHE BOOL "")
######################################################################################
##                              OPTIONS                                             ##
######################################################################################
set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64" CACHE STRING "")
# Be nice and export compile commands by default, this is handy for clang-tidy
# and for other tools.
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "")
######################################################################################
##                              COMPILE FLAGS                                       ##
######################################################################################
# CMAKE_CXX_EXTENSIONS will be generated by Conan
set(CMAKE_C_EXTENSIONS OFF)

# string(APPEND CMAKE_C_FLAGS_INIT " -Wall -Wextra -Werror")
# string(APPEND CMAKE_CXX_FLAGS_INIT " -Wall -Wextra -Werror")
set(CMAKE_C_FLAGS_DEBUG "-g -ggdb" CACHE STRING "")
set(CMAKE_CXX_FLAGS_DEBUG "-g -ggdb" CACHE STRING "")
set(CMAKE_C_FLAGS_RELEASE "-g -O3 -DNDEBUG" CACHE STRING "")
set(CMAKE_CXX_FLAGS_RELEASE "-g -O3 -DNDEBUG" CACHE STRING "") 

# Symbols will not export. Like "-fvisibility=hidden"
set(CMAKE_CXX_VISIBILITY_PRESET hidden CACHE BOOL "")
set(CMAKE_C_VISIBILITY_PRESET hidden CACHE BOOL "")
# Symbols will not export. Like "-fvisibility-inlines-hidden=1"
set(CMAKE_VISIBILITY_INLINES_HIDDEN 1 CACHE BOOL "")
# Convert GNU import libraries (.dll.a) to MS format (.lib).
# normally ON , cross-compile OFF
set(CMAKE_GNUtoMS OFF CACHE BOOL "") 
# Distinguish between Release lib and Debug lib
set(DEBUG_POSTFIX d CACHE STRING "Debug library postfix")
# It is always easier to navigate in an IDE when projects are organized in folders.
set(USE_FOLDERS ON CACHE BOOL "Enable project folders")
######################################################################################
##                              RPATH                                               ##
######################################################################################
SET(CMAKE_SKIP_BUILD_RPATH FALSE CACHE BOOL "")
SET(CMAKE_BUILD_WITH_INSTALL_RPATH TRUE CACHE BOOL "")

# note: macOS is APPLE and also UNIX !
# multi rpath
if(APPLE)
    set(CMAKE_INSTALL_RPATH "@loader_path;./" CACHE STRING "")
elseif(UNIX)
    set(CMAKE_INSTALL_RPATH "$ORIGIN:./" CACHE STRING "")
endif()
